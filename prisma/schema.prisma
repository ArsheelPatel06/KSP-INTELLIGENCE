  district           District? @relation(fields: [districtId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  state              State?    @relation(fields: [stateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceEvidence     Evidence? @relation(fields: [sourceEvidenceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entityType, entityOfficialId])
  @@map("address_history")
}

model Organization {
  id                         BigInt    @id @default(autoincrement()) @map("organization_id")
  organizationName           String    @map("organization_name") @db.VarChar(255)
  organizationType           String?   @map("organization_type") @db.VarChar(150)
  registrationIdentifierHash String?   @map("registration_identifier_hash") @db.VarChar(256)
  districtId                 BigInt?   @map("district_id")
  stateId                    BigInt?   @map("state_id")
  addressText                String?   @map("address_text") @db.Text
  roleInCase                 String?   @map("role_in_case") @db.VarChar(150)
  verificationStatus         String?   @map("verification_status") @db.VarChar(100)
  district                   District? @relation(fields: [districtId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  state                      State?    @relation(fields: [stateId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("organization")
}

model Hotspot {
  id                BigInt           @id @default(autoincrement()) @map("hotspot_id")
  hotspotName       String?          @map("hotspot_name") @db.VarChar(255)
  districtId        BigInt?          @map("district_id")
  unitId            BigInt?          @map("unit_id")
  crimeHeadId       BigInt?          @map("crime_head_id")
  crimeSubHeadId    BigInt?          @map("crime_sub_head_id")
  timeWindowStart   DateTime?        @map("time_window_start") @db.Timestamp(6)
  timeWindowEnd     DateTime?        @map("time_window_end") @db.Timestamp(6)
  boundaryReference String?          @map("boundary_reference") @db.Text
  centerLatitude    Decimal?         @map("center_latitude") @db.Decimal(12, 8)
  centerLongitude   Decimal?         @map("center_longitude") @db.Decimal(12, 8)
  riskLevel         String?          @map("risk_level") @db.VarChar(100)
  confidenceScore   Decimal?         @map("confidence_score") @db.Decimal(6, 4)
  trendDirection    String?          @map("trend_direction") @db.VarChar(100)
  generatedOn       DateTime         @default(now()) @map("generated_on") @db.Timestamp(6)
  modelVersion      String?          @map("model_version") @db.VarChar(100)
  district          District?        @relation(fields: [districtId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit              Unit?            @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  crimeHead         CrimeHead?       @relation(fields: [crimeHeadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  crimeSubHead      CrimeSubHead?    @relation(fields: [crimeSubHeadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cases             HotspotCase[]
  riskScores        RiskScore[]
  recommendations   Recommendation[]
  alerts            Alert[]

  @@index([districtId, timeWindowStart, timeWindowEnd])
  @@index([unitId, timeWindowStart, timeWindowEnd])
  @@index([riskLevel, confidenceScore])
  @@map("hotspot")
}

model HotspotCase {
  id                BigInt     @id @default(autoincrement()) @map("hotspot_case_id")
  hotspotId         BigInt     @map("hotspot_id")
  caseMasterId      BigInt     @map("case_master_id")
  contributionScore Decimal?   @map("contribution_score") @db.Decimal(6, 4)
  matchReason       String?    @map("match_reason") @db.Text
  hotspot           Hotspot    @relation(fields: [hotspotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  case              CaseMaster @relation(fields: [caseMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([hotspotId, caseMasterId])
  @@index([caseMasterId])
  @@map("hotspot_case")
}

model RiskScore {
  id                   BigInt           @id @default(autoincrement()) @map("risk_score_id")
  scoreSubjectType     String           @map("score_subject_type") @db.VarChar(100)
  caseMasterId         BigInt?          @map("case_master_id")
  accusedMasterId      BigInt?          @map("accused_master_id")
  victimMasterId       BigInt?          @map("victim_master_id")
  unitId               BigInt?          @map("unit_id")
  hotspotId            BigInt?          @map("hotspot_id")
  scoreType            String           @map("score_type") @db.VarChar(150)
  scoreValue           Decimal?         @map("score_value") @db.Decimal(10, 4)
  riskLevel            String?          @map("risk_level") @db.VarChar(100)
  explanationText      String?          @map("explanation_text") @db.Text
  confidenceScore      Decimal?         @map("confidence_score") @db.Decimal(6, 4)
  modelVersion         String?          @map("model_version") @db.VarChar(100)
  generatedOn          DateTime         @default(now()) @map("generated_on") @db.Timestamp(6)
  reviewStatus         String?          @default("pending") @map("review_status") @db.VarChar(100)
  reviewedByEmployeeId BigInt?          @map("reviewed_by_employee_id")
  case                 CaseMaster?      @relation(fields: [caseMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  accused              Accused?         @relation(fields: [accusedMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  victim               Victim?          @relation(fields: [victimMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit                 Unit?            @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hotspot              Hotspot?         @relation(fields: [hotspotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy           Employee?        @relation(fields: [reviewedByEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recommendations      Recommendation[]
  alerts               Alert[]

  @@index([caseMasterId, scoreType, generatedOn])
  @@index([accusedMasterId, scoreType, generatedOn])
  @@index([hotspotId, scoreType, generatedOn])
  @@map("risk_score")
}

model Recommendation {
  id                   BigInt                       @id @default(autoincrement()) @map("recommendation_id")
  caseMasterId         BigInt?                      @map("case_master_id")
  hotspotId            BigInt?                      @map("hotspot_id")
  riskScoreId          BigInt?                      @map("risk_score_id")
  recommendationType   String                       @map("recommendation_type") @db.VarChar(150)
  recommendationText   String                       @map("recommendation_text") @db.Text
  rationaleText        String?                      @map("rationale_text") @db.Text
  confidenceScore      Decimal?                     @map("confidence_score") @db.Decimal(6, 4)
  priorityLevel        String?                      @map("priority_level") @db.VarChar(100)
  modelVersion         String?                      @map("model_version") @db.VarChar(100)
  generatedOn          DateTime                     @default(now()) @map("generated_on") @db.Timestamp(6)
  status               String?                      @default("pending") @db.VarChar(100)
  reviewedByEmployeeId BigInt?                      @map("reviewed_by_employee_id")
  reviewNotes          String?                      @map("review_notes") @db.Text
  case                 CaseMaster?                  @relation(fields: [caseMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hotspot              Hotspot?                     @relation(fields: [hotspotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  riskScore            RiskScore?                   @relation(fields: [riskScoreId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy           Employee?                    @relation(fields: [reviewedByEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  legalSections        RecommendationLegalSection[]
  alerts               Alert[]
  tasks                Task[]
  chatMessages         ChatMessage[]
  searchRequests       SearchRequest[]

  @@index([caseMasterId, status, generatedOn])
  @@index([hotspotId, status, generatedOn])
  @@map("recommendation")
}

model RecommendationLegalSection {
  id                   BigInt         @id @default(autoincrement()) @map("recommendation_legal_section_id")
  recommendationId     BigInt         @map("recommendation_id")
  actCode              String         @map("act_code") @db.VarChar(50)
  sectionCode          String         @map("section_code") @db.VarChar(100)
  recommendationAction String         @map("recommendation_action") @db.VarChar(100)
  reasonText           String?        @map("reason_text") @db.Text
  confidenceScore      Decimal?       @map("confidence_score") @db.Decimal(6, 4)
  recommendation       Recommendation @relation(fields: [recommendationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  section              LegalSection   @relation(fields: [actCode, sectionCode], references: [actCode, sectionCode], onDelete: NoAction, onUpdate: NoAction)

  @@unique([recommendationId, actCode, sectionCode, recommendationAction])
  @@index([actCode, sectionCode])
  @@map("recommendation_legal_section")
}

model CaseSimilarity {
  id                   BigInt     @id @default(autoincrement()) @map("case_similarity_id")
  sourceCaseMasterId   BigInt     @map("source_case_master_id")
  matchedCaseMasterId  BigInt     @map("matched_case_master_id")
  similarityScore      Decimal    @map("similarity_score") @db.Decimal(10, 6)
  similarityType       String?    @map("similarity_type") @db.VarChar(150)
  reasonFeatures       String?    @map("reason_features") @db.Text
  modelVersion         String?    @map("model_version") @db.VarChar(100)
  generatedOn          DateTime   @default(now()) @map("generated_on") @db.Timestamp(6)
  reviewStatus         String?    @default("pending") @map("review_status") @db.VarChar(100)
  reviewedByEmployeeId BigInt?    @map("reviewed_by_employee_id")
  sourceCase           CaseMaster @relation("SimilaritySourceCase", fields: [sourceCaseMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  matchedCase          CaseMaster @relation("SimilarityMatchedCase", fields: [matchedCaseMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy           Employee?  @relation(fields: [reviewedByEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([sourceCaseMasterId, matchedCaseMasterId, similarityType])
  @@index([sourceCaseMasterId, similarityScore(sort: Desc)])
  @@index([matchedCaseMasterId, similarityScore(sort: Desc)])
  @@map("case_similarity")
}

model FeatureVectorRef {
  id                   BigInt      @id @default(autoincrement()) @map("feature_vector_id")
  entityType           String      @map("entity_type") @db.VarChar(100)
  entityOfficialId     BigInt?     @map("entity_official_id")
  aiEntityId           BigInt?     @map("ai_entity_id")
  vectorPurpose        String      @map("vector_purpose") @db.VarChar(150)
  modelVersion         String?     @map("model_version") @db.VarChar(100)
  generatedOn          DateTime    @default(now()) @map("generated_on") @db.Timestamp(6)
  vectorStoreReference String      @map("vector_store_reference") @db.Text
  featureSummary       String?     @map("feature_summary") @db.Text
  dataSourceId         BigInt?     @map("data_source_id")
  dataSource           DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entityType, entityOfficialId, vectorPurpose])
  @@map("feature_vector_ref")
}

model Alert {
  id                   BigInt          @id @default(autoincrement()) @map("alert_id")
  alertType            String          @map("alert_type") @db.VarChar(150)
  caseMasterId         BigInt?         @map("case_master_id")
  unitId               BigInt?         @map("unit_id")
  hotspotId            BigInt?         @map("hotspot_id")
  riskScoreId          BigInt?         @map("risk_score_id")
  recommendationId     BigInt?         @map("recommendation_id")
  severity             String?         @db.VarChar(100)
  alertText            String          @map("alert_text") @db.Text
  generatedOn          DateTime        @default(now()) @map("generated_on") @db.Timestamp(6)
  status               String?         @default("open") @db.VarChar(100)
  assignedToEmployeeId BigInt?         @map("assigned_to_employee_id")
  case                 CaseMaster?     @relation(fields: [caseMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit                 Unit?           @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hotspot              Hotspot?        @relation(fields: [hotspotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  riskScore            RiskScore?      @relation(fields: [riskScoreId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recommendation       Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedTo           Employee?       @relation(fields: [assignedToEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks                Task[]

  @@index([status, severity, generatedOn])
  @@index([assignedToEmployeeId, status])
  @@map("alert")
}

model Task {
  id                   BigInt          @id @default(autoincrement()) @map("task_id")
  caseMasterId         BigInt?         @map("case_master_id")
  recommendationId     BigInt?         @map("recommendation_id")
  alertId              BigInt?         @map("alert_id")
  assignedToEmployeeId BigInt?         @map("assigned_to_employee_id")
  taskTitle            String          @map("task_title") @db.VarChar(255)
  taskDescription      String?         @map("task_description") @db.Text
  priorityLevel        String?         @map("priority_level") @db.VarChar(100)
  dueDate              DateTime?       @map("due_date") @db.Date
  status               String?         @default("open") @db.VarChar(100)
  closureNotes         String?         @map("closure_notes") @db.Text
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  case                 CaseMaster?     @relation(fields: [caseMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recommendation       Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  alert                Alert?          @relation(fields: [alertId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedTo           Employee?       @relation(fields: [assignedToEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assignedToEmployeeId, status, dueDate])
  @@index([caseMasterId, status])
  @@map("task")
}

model ModelAuditLog {
  id                    BigInt        @id @default(autoincrement()) @map("model_audit_log_id")
  modelName             String        @map("model_name") @db.VarChar(255)
  modelVersion          String?       @map("model_version") @db.VarChar(100)
  runPurpose            String?       @map("run_purpose") @db.VarChar(150)
  inputEntityType       String?       @map("input_entity_type") @db.VarChar(100)
  inputEntityId         BigInt?       @map("input_entity_id")
  outputEntityType      String?       @map("output_entity_type") @db.VarChar(100)
  outputEntityId        BigInt?       @map("output_entity_id")
  confidenceScore       Decimal?      @map("confidence_score") @db.Decimal(6, 4)
  generatedOn           DateTime      @default(now()) @map("generated_on") @db.Timestamp(6)
  triggeredByEmployeeId BigInt?       @map("triggered_by_employee_id")
  reviewStatus          String?       @default("pending") @map("review_status") @db.VarChar(100)
  reviewNotes           String?       @map("review_notes") @db.Text
  triggeredBy           Employee?     @relation(fields: [triggeredByEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chatMessages          ChatMessage[]

  @@index([outputEntityType, outputEntityId])
  @@index([inputEntityType, inputEntityId])
  @@map("model_audit_log")
}

model ChatSession {
  id                     BigInt          @id @default(autoincrement()) @map("chat_session_id")
  employeeId             BigInt?         @map("employee_id")
  caseMasterId           BigInt?         @map("case_master_id")
  sessionStartedOn       DateTime        @default(now()) @map("session_started_on") @db.Timestamp(6)
  sessionEndedOn         DateTime?       @map("session_ended_on") @db.Timestamp(6)
  sessionPurpose         String?         @map("session_purpose") @db.VarChar(150)
  securityClassification String?         @map("security_classification") @db.VarChar(100)
  modelVersion           String?         @map("model_version") @db.VarChar(100)
  employee               Employee?       @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  case                   CaseMaster?     @relation(fields: [caseMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages               ChatMessage[]
  searchRequests         SearchRequest[]

  @@index([employeeId, sessionStartedOn])
  @@index([caseMasterId, sessionStartedOn])
  @@map("chat_session")
}

model ChatMessage {
  id                     BigInt          @id @default(autoincrement()) @map("chat_message_id")
  chatSessionId          BigInt          @map("chat_session_id")
  messageSequence        Int             @map("message_sequence")
  senderRole             String          @map("sender_role") @db.VarChar(50)
  messageText            String          @map("message_text") @db.Text
  createdOn              DateTime        @default(now()) @map("created_on") @db.Timestamp(6)
  linkedRecommendationId BigInt?         @map("linked_recommendation_id")
  linkedAuditLogId       BigInt?         @map("linked_audit_log_id")
  session                ChatSession     @relation(fields: [chatSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkedRecommendation   Recommendation? @relation(fields: [linkedRecommendationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkedAuditLog         ModelAuditLog?  @relation(fields: [linkedAuditLogId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([chatSessionId, messageSequence])
  @@index([chatSessionId, messageSequence])
  @@map("chat_message")
}

model SearchRequest {
  id                     BigInt          @id @default(autoincrement()) @map("search_request_id")
  employeeId             BigInt?         @map("employee_id")
  caseMasterId           BigInt?         @map("case_master_id")
  searchText             String          @map("search_text") @db.Text
  searchFiltersSummary   String?         @map("search_filters_summary") @db.Text
  requestedOn            DateTime        @default(now()) @map("requested_on") @db.Timestamp(6)
  resultSummary          String?         @map("result_summary") @db.Text
  linkedChatSessionId    BigInt?         @map("linked_chat_session_id")
  linkedRecommendationId BigInt?         @map("linked_recommendation_id")
  employee               Employee?       @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  case                   CaseMaster?     @relation(fields: [caseMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkedChatSession      ChatSession?    @relation(fields: [linkedChatSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkedRecommendation   Recommendation? @relation(fields: [linkedRecommendationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employeeId, requestedOn])
  @@map("search_request")
}

model KgNode {
  id               BigInt      @id @default(autoincrement()) @map("kg_node_id")
  nodeLabel        String      @map("node_label") @db.VarChar(100)
  sourceTable      String      @map("source_table") @db.VarChar(150)
  sourceRecordId   String      @map("source_record_id") @db.VarChar(150)
  displayName      String?     @map("display_name") @db.VarChar(500)
  sensitivityLevel String?     @map("sensitivity_level") @db.VarChar(100)
  qualityStatus    String?     @map("quality_status") @db.VarChar(100)
  sourceConfidence Decimal?    @map("source_confidence") @db.Decimal(6, 4)
  dataSourceId     BigInt?     @map("data_source_id")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime    @default(now()) @map("updated_at") @db.Timestamp(6)
  dataSource       DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  outgoingEdges    KgEdge[]    @relation("KgEdgeFrom")
  incomingEdges    KgEdge[]    @relation("KgEdgeTo")

  @@unique([sourceTable, sourceRecordId, nodeLabel])
  @@index([nodeLabel])
  @@index([sourceTable, sourceRecordId])
  @@map("kg_node")
}

model KgEdge {
  id                   BigInt      @id @default(autoincrement()) @map("kg_edge_id")
  fromKgNodeId         BigInt      @map("from_kg_node_id")
  toKgNodeId           BigInt      @map("to_kg_node_id")
  relationshipType     String      @map("relationship_type") @db.VarChar(150)
  sourceTable          String?     @map("source_table") @db.VarChar(150)
  sourceRecordId       String?     @map("source_record_id") @db.VarChar(150)
  confidenceScore      Decimal?    @map("confidence_score") @db.Decimal(6, 4)
  edgeWeight           Decimal?    @default(1.0) @map("edge_weight") @db.Decimal(10, 4)
  validFrom            DateTime?   @map("valid_from") @db.Timestamp(6)
  validTo              DateTime?   @map("valid_to") @db.Timestamp(6)
  evidenceId           BigInt?     @map("evidence_id")
  dataSourceId         BigInt?     @map("data_source_id")
  modelVersion         String?     @map("model_version") @db.VarChar(100)
  reviewStatus         String?     @default("accepted") @map("review_status") @db.VarChar(100)
  reviewedByEmployeeId BigInt?     @map("reviewed_by_employee_id")
  explanation          String?     @db.Text
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  fromNode             KgNode      @relation("KgEdgeFrom", fields: [fromKgNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toNode               KgNode      @relation("KgEdgeTo", fields: [toKgNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  evidence             Evidence?   @relation(fields: [evidenceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dataSource           DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy           Employee?   @relation(fields: [reviewedByEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fromKgNodeId, relationshipType])
  @@index([toKgNodeId, relationshipType])
  @@index([relationshipType])
  @@index([confidenceScore])
  @@map("kg_edge")
}

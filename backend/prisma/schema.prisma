generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DataSource {
  id                  BigInt                       @id @default(autoincrement()) @map("data_source_id")
  sourceName          String                       @map("source_name") @db.VarChar(255)
  sourceType          String                       @map("source_type") @db.VarChar(50)
  sourcePath          String?                      @map("source_path")
  sourceBatch         String?                      @map("source_batch") @db.VarChar(50)
  reportingMonth      Int?                         @map("reporting_month")
  reportingYear       Int?                         @map("reporting_year")
  extractedOn         DateTime?                    @map("extracted_on") @db.Timestamp(6)
  rowCount            BigInt?                      @map("row_count")
  pageCount           Int?                         @map("page_count")
  checksum            String?                      @unique(map: "uq_data_source_checksum") @db.VarChar(128)
  qualitySummary      String?                      @map("quality_summary")
  isDuplicate         Boolean                      @default(false) @map("is_duplicate")
  notes               String?
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime                     @default(now()) @map("updated_at") @db.Timestamp(6)
  cases               CaseMaster[]
  crimeReviewReports  CrimeReviewReport[]
  crimeStatistics     CrimeStatistic[]
  cyberStatistics     CyberSuspectStatistic[]
  dataQualityIssues   DataQualityIssue[]
  documentAttachments DocumentAttachment[]
  evidence            Evidence[]
  featureVectors      FeatureVectorRef[]
  ipcReferences       IpcSectionReference[]
  knowledgeGraphEdges KgEdge[]
  knowledgeGraphNodes KgNode[]
  legalDocuments      LegalDocumentSource[]
  ragDocuments        RagDocument[]
  roadStatistics      RoadAccidentStatistic[]
  serviceMetrics      ServicePerformanceMetric[]
  socialRelationships SocialRelationship[]
  victimStatistics    VictimDemographicStatistic[]

  @@map("data_source")
}

model GenderMaster {
  id           BigInt        @id @default(autoincrement()) @map("gender_id")
  name         String        @unique @map("gender_name") @db.VarChar(100)
  active       Boolean       @default(true)
  accused      Accused[]
  complainants Complainant[]
  employees    Employee[]
  victims      Victim[]
  witnesses    Witness[]

  @@map("gender_master")
}

model State {
  id               BigInt                       @id @default(autoincrement()) @map("state_id")
  name             String                       @unique(map: "uq_state_name") @map("state_name") @db.VarChar(150)
  nationalityId    BigInt?                      @map("nationality_id")
  active           Boolean                      @default(true)
  addresses        AddressHistory[]
  arrests          ArrestSurrender[]
  courts           Court[]
  cyberStatistics  CyberSuspectStatistic[]
  districts        District[]
  jails            Jail[]
  organizations    Organization[]
  units            Unit[]
  victimStatistics VictimDemographicStatistic[]

  @@map("state")
}

model District {
  id                     BigInt                     @id @default(autoincrement()) @map("district_id")
  name                   String                     @map("district_name") @db.VarChar(150)
  stateId                BigInt                     @map("state_id")
  active                 Boolean                    @default(true)
  addresses              AddressHistory[]
  arrests                ArrestSurrender[]
  courts                 Court[]
  crimeStatistics        CrimeStatistic[]
  state                  State                      @relation(fields: [stateId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_district_state")
  employees              Employee[]
  gangNetworks           GangNetwork[]
  hotspots               Hotspot[]
  jails                  Jail[]
  organizations          Organization[]
  repeatOffenderProfiles RepeatOffenderProfile[]
  roadStatistics         RoadAccidentStatistic[]
  serviceMetrics         ServicePerformanceMetric[]
  units                  Unit[]

  @@unique([name, stateId], map: "uq_district_state")
  @@index([stateId], map: "idx_district_state")
  @@map("district")
}

model UnitType {
  id             BigInt  @id @default(autoincrement()) @map("unit_type_id")
  name           String  @unique(map: "uq_unit_type_name") @map("unit_type_name") @db.VarChar(150)
  cityDistState  String? @map("city_dist_state") @db.VarChar(100)
  hierarchyLevel Int?    @map("hierarchy_level")
  active         Boolean @default(true)
  units          Unit[]

  @@map("unit_type")
}

model Unit {
  id              BigInt                     @id @default(autoincrement()) @map("unit_id")
  name            String                     @map("unit_name") @db.VarChar(255)
  unitTypeId      BigInt?                    @map("unit_type_id")
  parentUnitId    BigInt?                    @map("parent_unit_id")
  nationalityId   BigInt?                    @map("nationality_id")
  stateId         BigInt?                    @map("state_id")
  districtId      BigInt?                    @map("district_id")
  active          Boolean                    @default(true)
  sourceUnitCode  String?                    @map("source_unit_code") @db.VarChar(100)
  alerts          Alert[]
  arrests         ArrestSurrender[]
  cases           CaseMaster[]
  crimeStatistics CrimeStatistic[]
  employees       Employee[]
  gangNetworks    GangNetwork[]
  hotspots        Hotspot[]
  riskScores      RiskScore[]
  roadStatistics  RoadAccidentStatistic[]
  serviceMetrics  ServicePerformanceMetric[]
  district        District?                  @relation(fields: [districtId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_unit_district")
  parent          Unit?                      @relation("UnitHierarchy", fields: [parentUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_unit_parent")
  children        Unit[]                     @relation("UnitHierarchy")
  state           State?                     @relation(fields: [stateId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_unit_state")
  unitType        UnitType?                  @relation(fields: [unitTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_unit_unit_type")

  @@unique([name, districtId], map: "uq_unit_name_district")
  @@index([districtId], map: "idx_unit_district")
  @@index([parentUnitId], map: "idx_unit_parent")
  @@map("unit")
}

model Rank {
  id             BigInt     @id @default(autoincrement()) @map("rank_id")
  name           String     @unique @map("rank_name") @db.VarChar(150)
  hierarchyLevel Int?       @map("hierarchy_level")
  active         Boolean    @default(true)
  employees      Employee[]

  @@map("rank_master")
}

model Designation {
  id        BigInt     @id @default(autoincrement()) @map("designation_id")
  name      String     @unique @map("designation_name") @db.VarChar(150)
  active    Boolean    @default(true)
  sortOrder Int?       @map("sort_order")
  employees Employee[]

  @@map("designation")
}

model Employee {
  id                          BigInt                      @id @default(autoincrement()) @map("employee_id")
  districtId                  BigInt?                     @map("district_id")
  unitId                      BigInt?                     @map("unit_id")
  rankId                      BigInt?                     @map("rank_id")
  designationId               BigInt?                     @map("designation_id")
  kgid                        String?                     @unique(map: "uq_employee_kgid") @db.VarChar(100)
  firstName                   String?                     @map("first_name") @db.VarChar(255)
  employeeDob                 DateTime?                   @map("employee_dob") @db.Date
  genderId                    BigInt?                     @map("gender_id")
  bloodGroupId                BigInt?                     @map("blood_group_id")
  physicallyChallenged        Boolean?                    @map("physically_challenged")
  appointmentDate             DateTime?                   @map("appointment_date") @db.Date
  active                      Boolean                     @default(true)
  assignedAlerts              Alert[]
  arrestInvestigations        ArrestSurrender[]           @relation("ArrestInvestigatingOfficer")
  diaryEntries                CaseDiaryEntry[]
  registeredCases             CaseMaster[]                @relation("CasePolicePerson")
  similarityReviews           CaseSimilarity[]
  chargesheets                ChargesheetDetails[]
  chatSessions                ChatSession[]
  designation                 Designation?                @relation(fields: [designationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employee_designation")
  district                    District?                   @relation(fields: [districtId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employee_district")
  gender                      GenderMaster?               @relation(fields: [genderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employee_gender")
  rank                        Rank?                       @relation(fields: [rankId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employee_rank")
  unit                        Unit?                       @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_employee_unit")
  collectedEvidence           Evidence[]
  reviewedKnowledgeGraphEdges KgEdge[]
  modelRuns                   ModelAuditLog[]
  ragRetrievals               RagRetrievalLog[]
  recommendationReviews       Recommendation[]
  offenderLinkReviews         RepeatOffenderAccusedLink[]
  riskScoreReviews            RiskScore[]
  searchRequests              SearchRequest[]
  assignedTasks               Task[]

  passwordHash                String?                     @map("password_hash") @db.VarChar(255)
  role                        String                      @default("INVESTIGATING_OFFICER") @db.VarChar(50)
  tokenVersion                Int                         @default(0) @map("token_version")
  lastLoginAt                 DateTime?                   @map("last_login_at") @db.Timestamptz
  refreshTokens               RefreshToken[]
  authAuditLogs               AuthAuditLog[]

  @@index([districtId], map: "idx_employee_district")
  @@index([rankId], map: "idx_employee_rank")
  @@index([unitId], map: "idx_employee_unit")
  @@map("employee")
}

model Court {
  id              BigInt            @id @default(autoincrement()) @map("court_id")
  name            String            @map("court_name") @db.VarChar(255)
  districtId      BigInt?           @map("district_id")
  stateId         BigInt?           @map("state_id")
  active          Boolean           @default(true)
  arrests         ArrestSurrender[]
  cases           CaseMaster[]
  district        District?         @relation(fields: [districtId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_court_district")
  state           State?            @relation(fields: [stateId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_court_state")
  proceedings     CourtProceeding[]
  custodyStatuses CustodyStatus[]

  @@unique([name, districtId], map: "uq_court_name_district")
  @@map("court")
}

model CaseCategory {
  id          BigInt       @id @default(autoincrement()) @map("case_category_id")
  lookupValue String       @unique @map("lookup_value") @db.VarChar(150)
  active      Boolean      @default(true)
  cases       CaseMaster[]

  @@map("case_category")
}

model GravityOffence {
  id          BigInt       @id @default(autoincrement()) @map("gravity_offence_id")
  lookupValue String       @unique @map("lookup_value") @db.VarChar(150)
  active      Boolean      @default(true)
  cases       CaseMaster[]

  @@map("gravity_offence")
}

model CaseStatus {
  id     BigInt       @id @default(autoincrement()) @map("case_status_id")
  name   String       @unique @map("case_status_name") @db.VarChar(200)
  active Boolean      @default(true)
  cases  CaseMaster[]

  @@map("case_status_master")
}

model Occupation {
  id           BigInt        @id @default(autoincrement()) @map("occupation_id")
  name         String        @unique @map("occupation_name") @db.VarChar(200)
  active       Boolean       @default(true)
  complainants Complainant[]

  @@map("occupation_master")
}

model Religion {
  id           BigInt        @id @default(autoincrement()) @map("religion_id")
  name         String        @unique @map("religion_name") @db.VarChar(150)
  active       Boolean       @default(true)
  complainants Complainant[]

  @@map("religion_master")
}

model Caste {
  id           BigInt        @id @default(autoincrement()) @map("caste_master_id")
  name         String        @unique @map("caste_master_name") @db.VarChar(200)
  active       Boolean       @default(true)
  complainants Complainant[]

  @@map("caste_master")
}

model Act {
  code           String                @id @map("act_code") @db.VarChar(50)
  description    String                @map("act_description")
  shortName      String?               @map("short_name") @db.VarChar(150)
  active         Boolean               @default(true)
  legalDocuments LegalDocumentSource[]
  sections       LegalSection[]

  @@map("act")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model LegalSection {
  actCode                String                       @map("act_code") @db.VarChar(50)
  sectionCode            String                       @map("section_code") @db.VarChar(100)
  description            String?                      @map("section_description")
  active                 Boolean                      @default(true)
  caseAssociations       ActSectionAssociation[]
  crimeHeadMappings      CrimeHeadActSection[]
  ipcReferences          IpcSectionReference[]
  keywordMappings        LegalSectionKeyword[]
  recommendationMappings RecommendationLegalSection[]
  act                    Act                          @relation(fields: [actCode], references: [code], onDelete: NoAction, onUpdate: NoAction, map: "fk_section_act")

  @@id([actCode, sectionCode])
  @@map("section")
}

model CrimeHead {
  id              BigInt                @id @default(autoincrement()) @map("crime_head_id")
  groupName       String                @unique(map: "uq_crime_head_name") @map("crime_group_name") @db.VarChar(255)
  active          Boolean               @default(true)
  majorCases      CaseMaster[]          @relation("CaseMajorCrimeHead")
  sectionMappings CrimeHeadActSection[]
  crimeStatistics CrimeStatistic[]
  subHeads        CrimeSubHead[]
  gangNetworks    GangNetwork[]
  hotspots        Hotspot[]
  modusOperandi   ModusOperandi[]
  reportSections  ReportSection[]

  @@map("crime_head")
}

model CrimeSubHead {
  id              BigInt           @id @default(autoincrement()) @map("crime_sub_head_id")
  crimeHeadId     BigInt           @map("crime_head_id")
  name            String           @map("crime_head_name") @db.VarChar(255)
  sequenceId      Int?             @map("seq_id")
  active          Boolean          @default(true)
  minorCases      CaseMaster[]     @relation("CaseMinorCrimeHead")
  crimeStatistics CrimeStatistic[]
  crimeHead       CrimeHead        @relation(fields: [crimeHeadId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_crime_sub_head_parent")
  hotspots        Hotspot[]

  @@unique([crimeHeadId, name], map: "uq_crime_sub_head")
  @@map("crime_sub_head")
}

model CrimeHeadActSection {
  crimeHeadId BigInt       @map("crime_head_id")
  actCode     String       @map("act_code") @db.VarChar(50)
  sectionCode String       @map("section_code") @db.VarChar(100)
  crimeHead   CrimeHead    @relation(fields: [crimeHeadId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_chas_crime_head")
  section     LegalSection @relation(fields: [actCode, sectionCode], references: [actCode, sectionCode], onDelete: NoAction, onUpdate: NoAction, map: "fk_chas_section")

  @@id([crimeHeadId, actCode, sectionCode])
  @@map("crime_head_act_section")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model CaseMaster {
  id                    BigInt                      @id @default(autoincrement()) @map("case_master_id")
  crimeNo               String?                     @unique(map: "uq_case_crime_no") @map("crime_no") @db.VarChar(100)
  caseNo                String?                     @unique(map: "uq_case_case_no") @map("case_no") @db.VarChar(100)
  crimeRegisteredDate   DateTime?                   @map("crime_registered_date") @db.Timestamp(6)
  policePersonId        BigInt?                     @map("police_person_id")
  policeStationId       BigInt?                     @map("police_station_id")
  caseCategoryId        BigInt?                     @map("case_category_id")
  gravityOffenceId      BigInt?                     @map("gravity_offence_id")
  crimeMajorHeadId      BigInt?                     @map("crime_major_head_id")
  crimeMinorHeadId      BigInt?                     @map("crime_minor_head_id")
  caseStatusId          BigInt?                     @map("case_status_id")
  courtId               BigInt?                     @map("court_id")
  incidentFromDate      DateTime?                   @map("incident_from_date") @db.Timestamp(6)
  incidentToDate        DateTime?                   @map("incident_to_date") @db.Timestamp(6)
  infoReceivedPsDate    DateTime?                   @map("info_received_ps_date") @db.Timestamp(6)
  latitude              Decimal?                    @db.Decimal(10, 7)
  longitude             Decimal?                    @db.Decimal(10, 7)
  briefFacts            String?                     @map("brief_facts")
  dataSourceId          BigInt?                     @map("data_source_id")
  sourceRowNumber       BigInt?                     @map("source_row_number")
  sourceCaseKey         String?                     @map("source_case_key") @db.VarChar(255)
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime                    @default(now()) @map("updated_at") @db.Timestamp(6)
  accused               Accused[]
  actSections           ActSectionAssociation[]
  alerts                Alert[]
  arrests               ArrestSurrender[]
  diaryEntries          CaseDiaryEntry[]
  featureSnapshots      CaseFeatureSnapshot[]
  category              CaseCategory?               @relation(fields: [caseCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_case_category")
  court                 Court?                      @relation(fields: [courtId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_case_court")
  dataSource            DataSource?                 @relation(fields: [dataSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_case_data_source")
  policePerson          Employee?                   @relation("CasePolicePerson", fields: [policePersonId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_case_employee")
  gravity               GravityOffence?             @relation(fields: [gravityOffenceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_case_gravity")
  majorCrimeHead        CrimeHead?                  @relation("CaseMajorCrimeHead", fields: [crimeMajorHeadId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_case_major_head")
  minorCrimeHead        CrimeSubHead?               @relation("CaseMinorCrimeHead", fields: [crimeMinorHeadId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_case_minor_head")
  policeStation         Unit?                       @relation(fields: [policeStationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_case_station")
  status                CaseStatus?                 @relation(fields: [caseStatusId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_case_status")
  matchedSimilarities   CaseSimilarity[]            @relation("SimilarityMatchedCase")
  sourceSimilarities    CaseSimilarity[]            @relation("SimilaritySourceCase")
  chargesheets          ChargesheetDetails[]
  chatSessions          ChatSession[]
  complainants          Complainant[]
  courtProceedings      CourtProceeding[]
  custodyStatuses       CustodyStatus[]
  documents             DocumentAttachment[]
  evidence              Evidence[]
  financialAccounts     FinancialAccount[]
  financialTransactions FinancialTransaction[]
  forensicReports       ForensicReport[]
  geoLocations          GeoLocation[]
  hotspotLinks          HotspotCase[]
  occurrence            InvestigationOccurrence?
  modusOperandi         ModusOperandi[]
  digitalIdentifiers    PhoneDigitalIdentifier[]
  propertyAssets        PropertyAsset[]
  ragDocuments          RagDocument[]
  ragRetrievals         RagRetrievalLog[]
  recommendations       Recommendation[]
  offenderLinks         RepeatOffenderAccusedLink[]
  riskScores            RiskScore[]
  searchRequests        SearchRequest[]
  socialRelationships   SocialRelationship[]
  tasks                 Task[]
  vehicles              Vehicle[]
  victims               Victim[]
  weapons               Weapon[]
  witnesses             Witness[]

  @@index([courtId], map: "idx_case_court")
  @@index([crimeMajorHeadId, crimeMinorHeadId], map: "idx_case_crime_heads")
  @@index([latitude, longitude], map: "idx_case_geo")
  @@index([crimeRegisteredDate], map: "idx_case_registered_date")
  @@index([sourceCaseKey], map: "idx_case_source_key")
  @@index([policeStationId, crimeRegisteredDate], map: "idx_case_station_date")
  @@index([caseStatusId], map: "idx_case_status")
  @@map("case_master")
}

model Complainant {
  id                  BigInt                   @id @default(autoincrement()) @map("complainant_id")
  caseMasterId        BigInt                   @map("case_master_id")
  complainantNameHash String?                  @map("complainant_name_hash") @db.VarChar(256)
  ageYear             Int?                     @map("age_year")
  occupationId        BigInt?                  @map("occupation_id")
  religionId          BigInt?                  @map("religion_id")
  casteId             BigInt?                  @map("caste_id")
  genderId            BigInt?                  @map("gender_id")
  case                CaseMaster               @relation(fields: [caseMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_complainant_case")
  caste               Caste?                   @relation(fields: [casteId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_complainant_caste")
  gender              GenderMaster?            @relation(fields: [genderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_complainant_gender")
  occupation          Occupation?              @relation(fields: [occupationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_complainant_occupation")
  religion            Religion?                @relation(fields: [religionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_complainant_religion")
  digitalIdentifiers  PhoneDigitalIdentifier[]

  @@index([caseMasterId], map: "idx_complainant_case")
  @@map("complainant_details")
}

model Victim {
  id                 BigInt                   @id @default(autoincrement()) @map("victim_master_id")
  caseMasterId       BigInt                   @map("case_master_id")
  victimNameHash     String?                  @map("victim_name_hash") @db.VarChar(256)
  ageYear            Int?                     @map("age_year")
  genderId           BigInt?                  @map("gender_id")
  victimPolice       Boolean?                 @map("victim_police")
  financialAccounts  FinancialAccount[]
  digitalIdentifiers PhoneDigitalIdentifier[]
  propertyAssets     PropertyAsset[]
  riskScores         RiskScore[]
  vehicles           Vehicle[]
  case               CaseMaster               @relation(fields: [caseMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_victim_case")
  gender             GenderMaster?            @relation(fields: [genderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_victim_gender")
  weapons            Weapon[]

  @@index([caseMasterId], map: "idx_victim_case")
  @@map("victim")
}

model Accused {
  id                 BigInt                      @id @default(autoincrement()) @map("accused_master_id")
  caseMasterId       BigInt                      @map("case_master_id")
  accusedNameHash    String?                     @map("accused_name_hash") @db.VarChar(256)
  ageYear            Int?                        @map("age_year")
  genderId           BigInt?                     @map("gender_id")
  personId           String?                     @map("person_id") @db.VarChar(50)
  case               CaseMaster                  @relation(fields: [caseMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_accused_case")
  gender             GenderMaster?               @relation(fields: [genderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_accused_gender")
  primaryArrests     ArrestSurrender[]           @relation("ArrestPrimaryAccused")
  custodyStatuses    CustodyStatus[]
  financialAccounts  FinancialAccount[]
  gangMemberships    GangNetworkMember[]
  arrestLinks        ArrestSurrenderAccused[]
  digitalIdentifiers PhoneDigitalIdentifier[]
  offenderLinks      RepeatOffenderAccusedLink[]
  riskScores         RiskScore[]
  vehicles           Vehicle[]
  weapons            Weapon[]

  @@index([caseMasterId], map: "idx_accused_case")
  @@map("accused")
}

model ArrestSurrender {
  id                        BigInt                   @id @default(autoincrement()) @map("arrest_surrender_id")
  caseMasterId              BigInt                   @map("case_master_id")
  arrestSurrenderTypeId     BigInt?                  @map("arrest_surrender_type_id")
  arrestSurrenderDate       DateTime?                @map("arrest_surrender_date") @db.Timestamp(6)
  arrestSurrenderStateId    BigInt?                  @map("arrest_surrender_state_id")
  arrestSurrenderDistrictId BigInt?                  @map("arrest_surrender_district_id")
  policeStationId           BigInt?                  @map("police_station_id")
  ioId                      BigInt?                  @map("io_id")
  courtId                   BigInt?                  @map("court_id")
  accusedMasterId           BigInt?                  @map("accused_master_id")
  isAccused                 Boolean?                 @map("is_accused")
  isComplainantAccused      Boolean?                 @map("is_complainant_accused")
  primaryAccused            Accused?                 @relation("ArrestPrimaryAccused", fields: [accusedMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_arrest_accused")
  case                      CaseMaster               @relation(fields: [caseMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_arrest_case")
  court                     Court?                   @relation(fields: [courtId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_arrest_court")
  district                  District?                @relation(fields: [arrestSurrenderDistrictId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_arrest_district")
  investigatingOfficer      Employee?                @relation("ArrestInvestigatingOfficer", fields: [ioId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_arrest_io")
  state                     State?                   @relation(fields: [arrestSurrenderStateId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_arrest_state")

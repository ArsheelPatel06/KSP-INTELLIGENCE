  linkedAuditLogId       BigInt?         @map("linked_audit_log_id")
  linkedAuditLog         ModelAuditLog?  @relation(fields: [linkedAuditLogId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_chat_message_audit")
  linkedRecommendation   Recommendation? @relation(fields: [linkedRecommendationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_chat_message_reco")
  session                ChatSession     @relation(fields: [chatSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_chat_message_session")

  @@unique([chatSessionId, messageSequence], map: "uq_chat_message_sequence")
  @@index([chatSessionId, messageSequence], map: "idx_chat_message_session")
  @@map("chat_message")
}

model SearchRequest {
  id                     BigInt          @id @default(autoincrement()) @map("search_request_id")
  employeeId             BigInt?         @map("employee_id")
  caseMasterId           BigInt?         @map("case_master_id")
  searchText             String          @map("search_text")
  searchFiltersSummary   String?         @map("search_filters_summary")
  requestedOn            DateTime        @default(now()) @map("requested_on") @db.Timestamp(6)
  resultSummary          String?         @map("result_summary")
  linkedChatSessionId    BigInt?         @map("linked_chat_session_id")
  linkedRecommendationId BigInt?         @map("linked_recommendation_id")
  case                   CaseMaster?     @relation(fields: [caseMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_search_case")
  linkedChatSession      ChatSession?    @relation(fields: [linkedChatSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_search_chat")
  employee               Employee?       @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_search_employee")
  linkedRecommendation   Recommendation? @relation(fields: [linkedRecommendationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_search_reco")

  @@index([employeeId, requestedOn], map: "idx_search_employee_time")
  @@map("search_request")
}

model KgNode {
  id               BigInt      @id @default(autoincrement()) @map("kg_node_id")
  nodeLabel        String      @map("node_label") @db.VarChar(100)
  sourceTable      String      @map("source_table") @db.VarChar(150)
  sourceRecordId   String      @map("source_record_id") @db.VarChar(150)
  displayName      String?     @map("display_name") @db.VarChar(500)
  sensitivityLevel String?     @map("sensitivity_level") @db.VarChar(100)
  qualityStatus    String?     @map("quality_status") @db.VarChar(100)
  sourceConfidence Decimal?    @map("source_confidence") @db.Decimal(6, 4)
  dataSourceId     BigInt?     @map("data_source_id")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime    @default(now()) @map("updated_at") @db.Timestamp(6)
  outgoingEdges    KgEdge[]    @relation("KgEdgeFrom")
  incomingEdges    KgEdge[]    @relation("KgEdgeTo")
  dataSource       DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_kg_node_source")

  @@unique([sourceTable, sourceRecordId, nodeLabel], map: "uq_kg_node_source")
  @@index([nodeLabel], map: "idx_kg_node_label")
  @@index([sourceTable, sourceRecordId], map: "idx_kg_node_source")
  @@map("kg_node")
}

model KgEdge {
  id                   BigInt      @id @default(autoincrement()) @map("kg_edge_id")
  fromKgNodeId         BigInt      @map("from_kg_node_id")
  toKgNodeId           BigInt      @map("to_kg_node_id")
  relationshipType     String      @map("relationship_type") @db.VarChar(150)
  sourceTable          String?     @map("source_table") @db.VarChar(150)
  sourceRecordId       String?     @map("source_record_id") @db.VarChar(150)
  confidenceScore      Decimal?    @map("confidence_score") @db.Decimal(6, 4)
  edgeWeight           Decimal?    @default(1.0) @map("edge_weight") @db.Decimal(10, 4)
  validFrom            DateTime?   @map("valid_from") @db.Timestamp(6)
  validTo              DateTime?   @map("valid_to") @db.Timestamp(6)
  evidenceId           BigInt?     @map("evidence_id")
  dataSourceId         BigInt?     @map("data_source_id")
  modelVersion         String?     @map("model_version") @db.VarChar(100)
  reviewStatus         String?     @default("accepted") @map("review_status") @db.VarChar(100)
  reviewedByEmployeeId BigInt?     @map("reviewed_by_employee_id")
  explanation          String?
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  evidence             Evidence?   @relation(fields: [evidenceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_kg_edge_evidence")
  fromNode             KgNode      @relation("KgEdgeFrom", fields: [fromKgNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_kg_edge_from")
  reviewedBy           Employee?   @relation(fields: [reviewedByEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_kg_edge_reviewer")
  dataSource           DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_kg_edge_source")
  toNode               KgNode      @relation("KgEdgeTo", fields: [toKgNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_kg_edge_to")

  @@index([confidenceScore], map: "idx_kg_edge_confidence")
  @@index([fromKgNodeId, relationshipType], map: "idx_kg_edge_from_type")
  @@index([relationshipType], map: "idx_kg_edge_relationship")
  @@index([toKgNodeId, relationshipType], map: "idx_kg_edge_to_type")
  @@map("kg_edge")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(255)
  employeeId        BigInt    @map("employee_id")
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdByIp       String?   @map("created_by_ip") @db.VarChar(45)

  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([familyId])
  @@map("auth_refresh_token")
}

model AuthAuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  BigInt?   @map("employee_id")
  event       String    @db.VarChar(50)
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent")
  metadata    Json?     @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([event])
  @@map("auth_audit_log")
}
